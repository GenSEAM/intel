;; Package Grammar & Exported Symbol Registry (ASN)
;; @genseam/asl-intel
(:grammar
  :package @genseam/asl-intel
  :version "0.1.0"
  :tokens-baseline 2
  :symbols [
    ;; Core Types (<= 2 tokens)
    (:sym :name "SymbolKind" :kind :type :tokens 1)
    (:sym :name "sym-fn" :kind :val :tokens 2)
    (:sym :name "sym-type" :kind :val :tokens 2)
    (:sym :name "sym-record" :kind :val :tokens 2)
    (:sym :name "sym-enum" :kind :val :tokens 2)
    (:sym :name "sym-method" :kind :val :tokens 2)
    (:sym :name "sym-class" :kind :val :tokens 2)
    (:sym :name "sym-interface" :kind :val :tokens 2)
    (:sym :name "sym-variable" :kind :val :tokens 2)
    (:sym :name "SymbolDef" :kind :type :tokens 1)
    (:sym :name "SymbolRef" :kind :type :tokens 1)
    (:sym :name "FileSymbols" :kind :type :tokens 1)
    (:sym :name "filter-exported" :kind :fn :tokens 2)
    (:sym :name "QueryKind" :kind :type :tokens 1)
    (:sym :name "q-search" :kind :val :tokens 2)
    (:sym :name "q-callers" :kind :val :tokens 2)
    (:sym :name "q-callees" :kind :val :tokens 2)
    (:sym :name "q-impact" :kind :val :tokens 2)
    (:sym :name "q-affected" :kind :val :tokens 2)
    (:sym :name "q-context" :kind :val :tokens 2)
    (:sym :name "ImpactItem" :kind :type :tokens 1)
    (:sym :name "QueryResult" :kind :type :tokens 1)
    (:sym :name "EdgeKind" :kind :type :tokens 1)
    (:sym :name "edge-calls" :kind :val :tokens 2)
    (:sym :name "edge-defines" :kind :val :tokens 2)
    (:sym :name "edge-imports" :kind :val :tokens 2)
    (:sym :name "edge-implements" :kind :val :tokens 2)
    (:sym :name "edge-subtypes" :kind :val :tokens 2)
    (:sym :name "GraphNode" :kind :type :tokens 1)
    (:sym :name "GraphEdge" :kind :type :tokens 1)
    (:sym :name "SymbolGraph" :kind :type :tokens 1)
    (:sym :name "graph-create" :kind :fn :tokens 2)
    (:sym :name "intel-version" :kind :fn :tokens 2)
    (:sym :name "intel-banner" :kind :fn :tokens 2)

    ;; Extended Operations (> 2 tokens with required :rationale)
    (:sym :name "kind-to-string" :kind :fn :tokens 3
          :rationale "Serializes SymbolKind enumeration into canonical lowercase string")
    (:sym :name "string-to-kind" :kind :fn :tokens 3
          :rationale "Parses string representation back into strongly typed SymbolKind")
    (:sym :name "parse-asl-tokens" :kind :fn :tokens 3
          :rationale "Lightweight character tokenizer extracting S-expression tokens from ASL source")
    (:sym :name "extract-asl-symbols" :kind :fn :tokens 3
          :rationale "Extracts top-level function, schema, and enum definitions from ASL files")
    (:sym :name "extract-generic-symbols" :kind :fn :tokens 3
          :rationale "Fallback heuristic extractor for non-ASL files using indentation and keywords")
    (:sym :name "encode-symbol-asn" :kind :fn :tokens 3
          :rationale "Serializes SymbolDef into compact ASN S-expression node")
    (:sym :name "encode-edge-asn" :kind :fn :tokens 3
          :rationale "Serializes GraphEdge relationship into ASN S-expression tuple")
    (:sym :name "encode-impact-asn" :kind :fn :tokens 3
          :rationale "Serializes transitive blast-radius impact analysis into ASN notation")
    (:sym :name "encode-asn-response" :kind :fn :tokens 3
          :rationale "Renders high-level query response payload into token-compressed ASN format")
    (:sym :name "format-query-kind" :kind :fn :tokens 3
          :rationale "Converts QueryKind enum into display string for telemetry and logging")
    (:sym :name "filter-by-depth" :kind :fn :tokens 3
          :rationale "Prunes transitive dependency traversal items beyond specified search depth")
    (:sym :name "make-query-result" :kind :fn :tokens 3
          :rationale "Constructor initializing typed QueryResult with items and query duration")
    (:sym :name "edge-kind-to-string" :kind :fn :tokens 4
          :rationale "Converts EdgeKind relationship variant to standard string label")
    (:sym :name "graph-add-node" :kind :fn :tokens 3
          :rationale "Appends symbol vertex node into immutable SymbolGraph structure")
    (:sym :name "graph-add-edge" :kind :fn :tokens 3
          :rationale "Appends directional dependency edge between nodes in SymbolGraph")
    (:sym :name "graph-node-count" :kind :fn :tokens 3
          :rationale "Computes cardinal number of vertex nodes indexed in the symbol graph")
    (:sym :name "graph-edge-count" :kind :fn :tokens 3
          :rationale "Computes total count of dependency edges registered in the symbol graph")
    (:sym :name "test-intel-version" :kind :fn :tokens 3
          :rationale "Verification test checking intel engine semver string")
    (:sym :name "test-intel-banner" :kind :fn :tokens 3
          :rationale "Verification test checking intel engine banner and brand grounding")

    ;; Preload Module Symbols
    (:sym :name "PreloadTier" :kind :type :tokens 1)
    (:sym :name "tier-micro-ast" :kind :val :tokens 3
          :rationale "Micro-AST tier 3 representation")
    (:sym :name "tier-meso-symbol" :kind :val :tokens 3
          :rationale "Meso-Symbol tier 2 representation")
    (:sym :name "tier-macro-topology" :kind :val :tokens 3
          :rationale "Macro-Topology tier 1 representation")
    (:sym :name "SymbolStub" :kind :type :tokens 1)
    (:sym :name "PreloadedHorizon" :kind :type :tokens 1)
    (:sym :name "preload-tier-to-string" :kind :fn :tokens 4
          :rationale "Converts PreloadTier enum to string representation")
    (:sym :name "estimate-tokens" :kind :fn :tokens 2)
    (:sym :name "estimate-stub-tokens" :kind :fn :tokens 3
          :rationale "Estimates token consumption for symbol stub")
    (:sym :name "stub-create" :kind :fn :tokens 2)
    (:sym :name "horizon-create" :kind :fn :tokens 2)
    (:sym :name "horizon-add-stub" :kind :fn :tokens 3
          :rationale "Appends symbol stub to preloaded horizon with budget check")
    (:sym :name "intel-preload-graph" :kind :fn :tokens 3
          :rationale "Hydrates graph horizon up to depth k bounded by token ceiling")
    (:sym :name "intel-preload" :kind :fn :tokens 2)
    (:sym :name "format-preload-context" :kind :fn :tokens 3
          :rationale "Renders preloaded horizon into dense ASN context string")

    ;; Preload Test Symbols
    (:sym :name "test-stub-token-estimation" :kind :fn :tokens 4
          :rationale "Tests token estimation on symbol stubs")
    (:sym :name "test-preload-tier-conversion" :kind :fn :tokens 4
          :rationale "Tests conversion of preload tier enum to string")
    (:sym :name "test-horizon-budget-enforcement" :kind :fn :tokens 4
          :rationale "Tests horizon budget enforcement and truncation")
    (:sym :name "test-horizon-add-stub-budget" :kind :fn :tokens 5
          :rationale "Tests adding stubs under token budget constraints")
    (:sym :name "test-horizon-zero-budget" :kind :fn :tokens 4
          :rationale "Tests zero budget edge case in horizon")
    (:sym :name "test-intel-preload-graph-multi-tier" :kind :fn :tokens 6
          :rationale "Tests multi-tier hydration in graph horizon paging")
    (:sym :name "test-intel-preload-depth-scoping" :kind :fn :tokens 5
          :rationale "Tests depth scoping boundary conditions in preload")
    (:sym :name "test-intel-preload-empty-target" :kind :fn :tokens 5
          :rationale "Tests empty target string boundary in preload")
    (:sym :name "test-intel-preload-missing-target" :kind :fn :tokens 5
          :rationale "Tests missing symbol target lookup in preload")
    (:sym :name "test-intel-preload-zero-depth" :kind :fn :tokens 5
          :rationale "Tests zero depth scoping boundary in preload")
    (:sym :name "test-format-preload-context" :kind :fn :tokens 4
          :rationale "Tests formatting of preloaded horizon into string context")
    (:sym :name "run-tests" :kind :fn :tokens 2)

    ;; Health Module Symbols
    (:sym :name "HealthAnomalyKind" :kind :type :tokens 1)
    (:sym :name "anomaly-cycle" :kind :val :tokens 2)
    (:sym :name "anomaly-blast-radius" :kind :val :tokens 3
          :rationale "Anomaly variant flagging high fan-in blast radius hotspots")
    (:sym :name "anomaly-orphan-export" :kind :val :tokens 3
          :rationale "Anomaly variant flagging exported symbols with zero callers")
    (:sym :name "anomaly-signature-mismatch" :kind :val :tokens 3
          :rationale "Anomaly variant flagging signature mismatch across calls")
    (:sym :name "anomaly-complexity-hotspot" :kind :val :tokens 3
          :rationale "Anomaly variant flagging cyclomatic complexity line span hotspots")
    (:sym :name "anomaly-layer-leakage" :kind :val :tokens 3
          :rationale "Anomaly variant flagging illegal cross-layer upward dependencies")
    (:sym :name "HealthAnomaly" :kind :type :tokens 1)
    (:sym :name "HealthMatrix" :kind :type :tokens 1)
    (:sym :name "health-anomaly-kind-to-string" :kind :fn :tokens 5
          :rationale "Converts HealthAnomalyKind enum to string")
    (:sym :name "detect-import-cycles" :kind :fn :tokens 3
          :rationale "Detects circular dependency cycles across module imports")
    (:sym :name "detect-blast-radius-hotspots" :kind :fn :tokens 3
          :rationale "Flags symbols with high fan-in in-degree")
    (:sym :name "detect-orphan-exports" :kind :fn :tokens 3
          :rationale "Detects exported symbols with zero incoming references")
    (:sym :name "detect-signature-mismatches" :kind :fn :tokens 3
          :rationale "Validates signature parameter parity across calls")
    (:sym :name "detect-cyclomatic-hotspots" :kind :fn :tokens 3
          :rationale "Flags functions exceeding line span complexity threshold")
    (:sym :name "module-to-layer" :kind :fn :tokens 3
          :rationale "Maps package or module identifier to architectural layer tier")
    (:sym :name "is-agent-id?" :kind :fn :tokens 3
          :rationale "Identifies agent identity references e.g. @scout, @coder, @reviewer")
    (:sym :name "detect-layer-leakage" :kind :fn :tokens 3
          :rationale "Traps illegal cross-layer upward dependencies and agent ID references")
    (:sym :name "build-health-matrix" :kind :fn :tokens 3
          :rationale "Aggregates structural health checks into unified matrix")
    (:sym :name "intel-health" :kind :fn :tokens 2)
    (:sym :name "format-health-report" :kind :fn :tokens 3
          :rationale "Renders structural health matrix into formatted diagnostic report")

    ;; Health Test Symbols
    (:sym :name "test-detect-cycles-clean-dag" :kind :fn :tokens 5
          :rationale "Tests cycle detection on clean acyclic DAG")
    (:sym :name "test-detect-cycles-diamond-dag" :kind :fn :tokens 5
          :rationale "Tests cycle detection on diamond DAG topology")
    (:sym :name "test-detect-self-cycle" :kind :fn :tokens 4
          :rationale "Tests cycle detection on self-referential import")
    (:sym :name "test-blast-radius-hotspot" :kind :fn :tokens 4
          :rationale "Tests detection of high fan-in blast radius hotspots")
    (:sym :name "test-orphan-exports" :kind :fn :tokens 3
          :rationale "Tests detection of uncalled exported symbols")
    (:sym :name "test-cyclomatic-hotspot" :kind :fn :tokens 3
          :rationale "Tests detection of high complexity line span hotspots")
    (:sym :name "test-build-health-matrix" :kind :fn :tokens 4
          :rationale "Tests complete health matrix construction and status")

    ;; Boundary Test Symbols
    (:sym :name "test-module-to-layer-mapping" :kind :fn :tokens 4
          :rationale "Tests architectural layer tier mapping for core packages")
    (:sym :name "test-boundary-clean-dag" :kind :fn :tokens 4
          :rationale "Tests downward clean DAG zero leakage invariants")
    (:sym :name "test-boundary-layer0-clean" :kind :fn :tokens 4
          :rationale "Tests Layer 0 self-containment zero leakage invariants")
    (:sym :name "test-boundary-trap-layer0-import-layer1" :kind :fn :tokens 7
          :rationale "Tests trapping illegal Layer 0 to Layer 1 import leakage")
    (:sym :name "test-boundary-trap-agent-id-leakage" :kind :fn :tokens 6
          :rationale "Tests trapping prohibited agent ID references in Layer 0")
    (:sym :name "test-boundary-trap-layer0-import-layer3" :kind :fn :tokens 7
          :rationale "Tests trapping illegal Layer 0 to Layer 3 import leakage")
    (:sym :name "test-boundary-trap-layer1-import-layer3" :kind :fn :tokens 7
          :rationale "Tests trapping illegal Layer 1 to Layer 3 import leakage")

    ;; Text & Document Intelligence Symbols
    (:sym :name "TextSection" :kind :type :tokens 1)
    (:sym :name "TextDocOutline" :kind :type :tokens 1)
    (:sym :name "TextMatchSlice" :kind :type :tokens 1)
    (:sym :name "scan-doc-outline" :kind :fn :tokens 3
          :rationale "Scans markdown document headers to build structural outline")
    (:sym :name "extract-doc-section" :kind :fn :tokens 3
          :rationale "Extracts targeted chapter or section slice without full file read")
    (:sym :name "search-doc-snippets" :kind :fn :tokens 3
          :rationale "Searches document text for matching keyword snippets with line numbers")
    (:sym :name "format-doc-outline-asn" :kind :fn :tokens 4
          :rationale "Serializes document structural outline into compact ASN S-expression")
    (:sym :name "format-section-asn" :kind :fn :tokens 3
          :rationale "Serializes targeted section slice into compact ASN notation")

    ;; Text Scan Test Symbols
    (:sym :name "test-scan-doc-outline" :kind :fn :tokens 4
          :rationale "Tests header extraction and line calculation")
    (:sym :name "test-extract-doc-section" :kind :fn :tokens 4
          :rationale "Tests selective extraction of targeted markdown chapter")
    (:sym :name "test-search-doc-snippets" :kind :fn :tokens 4
          :rationale "Tests keyword snippet search with line numbers")
    (:sym :name "test-format-doc-outline-asn" :kind :fn :tokens 5
          :rationale "Tests ASN outline formatting")
    (:sym :name "test-format-section-asn" :kind :fn :tokens 4
          :rationale "Tests ASN section slice formatting")

    ;; Diagram Generation Symbols
    (:sym :name "DiagramFormat" :kind :type :tokens 1)
    (:sym :name "diagram-format-mermaid" :kind :val :tokens 3
          :rationale "Mermaid graph TD diagram format variant")
    (:sym :name "diagram-format-asn" :kind :val :tokens 3
          :rationale "ASN S-expression DAG diagram format variant")
    (:sym :name "diagram-format-to-string" :kind :fn :tokens 4
          :rationale "Converts DiagramFormat enum to canonical string")
    (:sym :name "generate-mermaid-diagram" :kind :fn :tokens 3
          :rationale "Generates Mermaid graph TD dependency diagram")
    (:sym :name "generate-asn-diagram" :kind :fn :tokens 3
          :rationale "Generates ASN S-expression dependency DAG")
    (:sym :name "generate-diagram" :kind :fn :tokens 2)
    (:sym :name "render-mermaid-dag" :kind :fn :tokens 3
          :rationale "Renders dependency graph in Mermaid graph TD format")
    (:sym :name "render-asn-dag" :kind :fn :tokens 3
          :rationale "Renders dependency graph in ASN S-expression format")

    ;; Diagram Test Symbols
    (:sym :name "test-diagram-mermaid-format" :kind :fn :tokens 4
          :rationale "Tests Mermaid format generation and syntax")
    (:sym :name "test-diagram-asn-format" :kind :fn :tokens 4
          :rationale "Tests ASN format generation and syntax")
    (:sym :name "test-diagram-diamond-dag" :kind :fn :tokens 4
          :rationale "Tests diamond DAG dependency formatting")
    (:sym :name "test-diagram-empty-graph" :kind :fn :tokens 4
          :rationale "Tests diagram generation edge cases on empty graph")
    (:sym :name "test-diagram-format-enum" :kind :fn :tokens 4
          :rationale "Tests diagram format enum dispatchers and aliases")

    ;; CLI Test Symbols
    (:sym :name "test-cli-health-matrix-structure" :kind :fn :tokens 5
          :rationale "Tests health matrix record fields and healthy invariant")
    (:sym :name "test-cli-orphans-filter" :kind :fn :tokens 4
          :rationale "Tests dead export anomaly identification and filtering")
    (:sym :name "test-cli-cycles-3state-dfs" :kind :fn :tokens 5
          :rationale "Tests 3-state DFS cycle detection across graphs")
    (:sym :name "test-cli-hotspots-threshold" :kind :fn :tokens 4
          :rationale "Tests blast radius and cyclomatic span thresholding")
  ]
)
